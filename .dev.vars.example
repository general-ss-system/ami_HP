# ローカル開発用。.dev.vars にコピーして使う（.dev.vars はコミットしない）。
# CMS 無しで制作するときは fixture のままでよい。
CMS_MODE=fixture
# live にする場合（CMS リポジトリで pnpm dev → pnpm -F @ss/backend dev:bootstrap の出力を使う）
# CMS_MODE=live
# CMS_BASE_URL=http://localhost:8787
# CMS_SITE_KEY=
# CMS_DELIVERY_KEY=
# お問い合わせフォームのボット対策（Cloudflare Turnstile）。live で送信するときに必要。
# ローカルで試すときは Cloudflare のテスト用キー（常に成功）: 1x00000000000000000000AA
# PUBLIC_TURNSTILE_SITE_KEY=

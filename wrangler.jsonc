{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ami-hp",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// 公開してよい値だけをここに置く。公開キー（CMS_DELIVERY_KEY）は
	// ローカルは .dev.vars、本番は `wrangler secret put CMS_DELIVERY_KEY` で渡す。
	"vars": {
		"CMS_MODE": "fixture"
	}
}

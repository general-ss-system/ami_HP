---
/**
 * ami のロゴ（マーク＋「ami」）。
 * 文字部分はデザインのベクターをそのまま使い、色は currentColor に従う。
 */
import LocalImage from "../ui/LocalImage.astro";
import markColor from "../../assets/brand/logo-mark-color.webp";
import markWhite from "../../assets/brand/logo-mark-white.webp";

interface Props {
  variant?: "color" | "white";
  /** マークの高さ（px）。文字は比率で決まる。 */
  height?: number;
}

const { variant = "color", height = 36 } = Astro.props;
const mark = variant === "white" ? markWhite : markColor;
---

<span class:list={["logo", `is-${variant}`]} style={{ "--h": `${height}px` }}>
  <LocalImage src={mark} alt="" class="logo__mark" />
  <svg class="logo__type" viewBox="1193 10.7 64.2 32.6" aria-hidden="true" focusable="false">
    <path d="M1252.83 43.2746V19.8875H1257.11V43.2746H1252.83ZM1252.83 15.8378V10.7251H1257.11V15.8378H1252.83Z" />
    <path
      d="M1220.37 43.2747V19.8877H1232.36V24.4942H1235.74V19.8877H1243.92V24.4942H1247.73V43.2747H1243.49V24.9498H1236.17V43.2747H1231.93V24.9498H1224.65V43.2747H1220.37Z"
    />
    <path
      d="M1196.85 43.2747V38.7188H1193V24.4942H1196.85V19.8877H1208.79V24.4942H1212.69V38.2126H1216.54V43.2747H1212.27V38.7188H1208.79V43.2747H1196.85ZM1197.28 38.2126H1208.37V24.9498H1197.28V38.2126Z"
    />
  </svg>
  <span class="visually-hidden">合同会社ami</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--h) * 0.39);
    color: var(--color-text);
  }

  .logo.is-white {
    color: #fff;
  }

  .logo__mark {
    width: auto;
    height: var(--h);
  }

  .logo__type {
    height: calc(var(--h) * 0.9);
    width: auto;
    fill: currentColor;
  }
</style>

---
/**
 * 地平線から下の、淡い斜線の地（Figma: service / contact）。EarthHeroDecor の帯のすぐ後に置く。
 * 地平線（楕円・水色の線）・ステッカー（Our Business / Contact）・案内文・飾りを持ち、本文は slot に入れる。
 * 位置は地平線（デザインの y=586）からの値。
 */
import type { ImageMetadata } from "astro";
import Decor from "../ui/Decor.astro";
import LocalImage from "../ui/LocalImage.astro";
import moonBunny from "../../assets/decor/moon-bunny.webp";
import rocket from "../../assets/decor/rocket.webp";
import sparkleGold from "../../assets/decor/sparkle-gold.webp";
import sparkleBlue from "../../assets/decor/sparkle-blue.webp";
import sparkleViolet from "../../assets/decor/sparkle-violet.webp";

interface Props {
  /** ステッカーの画像と、地平線からの位置 [x, y, 幅]（デザイン上の px） */
  sticker: ImageMetadata;
  stickerBox: [number, number, number];
  /** 案内文（CMS。改行で行を分ける）。空なら出さない */
  lead: string | null;
  /** 案内文の文字の上端（地平線から。デザイン上の px） */
  leadTop?: number;
}

const { sticker, stickerBox, lead, leadTop = 114 } = Astro.props;
const leadLines = lead ? lead.replace(/\r\n?/g, "\n").split("\n") : [];
---

<div class="sky">
  <div class="stage sky__stage" style={{ "--lead-top": leadTop, "--st-x": stickerBox[0], "--st-y": stickerBox[1], "--st-w": stickerBox[2] }}>
    <LocalImage src={sticker} alt="" class="sky__sticker" loading="eager" />

    <div class="sky__inner">
    {
      leadLines.length > 0 && (
        <p class="sky__lead">
          {leadLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )
    }

    <slot />
    </div>

    <Decor src={rocket} pc={[1022, -6, 140]} sp={false} front float delay={1.2} />
    <Decor src={moonBunny} pc={[191, 106, 132]} sp={false} front float delay={0.4} />
    <Decor src={sparkleGold} pc={[284, 71, 60]} sp={false} front twinkle delay={1.6} />
    <Decor src={sparkleGold} pc={[1081, 130, 60]} sp={false} front twinkle delay={0.7} />
    <Decor src={sparkleBlue} pc={[83, 90, 82]} sp={false} front twinkle delay={1.1} />
    <Decor src={sparkleBlue} pc={[933, 136, 82]} sp={false} front twinkle delay={0.3} />
    <Decor src={sparkleViolet} pc={[923, 61, 41]} sp={false} front twinkle delay={1.9} />
    <Decor src={sparkleViolet} pc={[155, 160, 41]} sp={false} front twinkle delay={0.9} />
  </div>
</div>

<style>
  /*
   * 地平線: 中心 x=639.5・横の半径 938.5・縦の半径 414 の楕円の上半分（y=586 が頂点）。線は #3AD4FF 4px。
   * 地は #F6FDFF に、45° の淡い斜線（#F1F8FA、20px ごと）。
   */
  .sky {
    --u: calc(min(100vw, 1280px) / 1280);
    position: relative;
    z-index: var(--z-content);
    padding-bottom: clamp(96px, calc(160 / 12.8 * 1vw), 160px);
    color: #1b1c22;
  }

  .sky::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: calc(1877 * var(--u));
    translate: -50% 0;
    background: repeating-linear-gradient(135deg, #f6fdff 0 7.07px, #f1f8fa 7.07px 14.14px);
    border: 4px solid #3ad4ff;
    border-bottom: 0;
    border-radius: 50% 50% 0 0 / calc(414 * var(--u)) calc(414 * var(--u)) 0 0;
  }

  /*
   * .stage の cqw は内容の幅が基準なので、stage には左右の余白を付けない（飾りの位置がずれる）。
   * 左右の余白は中身（.sky__inner）に付ける。
   */
  .sky__stage {
    padding: calc(var(--lead-top) / 12.8 * 1cqw) 0 0;
  }

  .sky__inner {
    padding-inline: var(--gutter);
  }

  .sky__stage :global(.sky__sticker) {
    position: absolute;
    z-index: 2;
    top: calc(var(--st-y) / 12.8 * 1cqw);
    left: calc(var(--st-x) / 12.8 * 1cqw);
    width: calc(var(--st-w) / 12.8 * 1cqw);
    min-width: calc(var(--st-w) * 0.46px);
    height: auto;
  }

  /* 22px・字間 0.17em・行の送り 46（文字の上端に合わせるため、行の余白の分だけ上へ） */
  .sky__lead {
    position: relative;
    z-index: var(--z-content);
    margin-top: -12px;
    font-size: clamp(15px, calc(22 / 12.8 * 1vw), 22px);
    line-height: 2.09;
    letter-spacing: 0.17em;
    text-align: center;
  }

  @media (max-width: 767px) {
    .sky__stage {
      padding-top: 72px;
    }

    .sky__inner {
      padding-inline: 16px;
    }

    .sky__stage :global(.sky__sticker) {
      top: -40px;
      left: 16px;
    }

    .sky__lead {
      margin-top: 0;
      letter-spacing: 0.06em;
    }
  }
</style>

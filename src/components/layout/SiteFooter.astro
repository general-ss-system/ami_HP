---
/**
 * フッター。地球のドット絵の上にロゴとナビを重ねる。
 * plain … 地球を出さず、淡い斜線の地（SkySection の続き）に黒の文字・ボタンで並べる（service / contact）
 * SNS のリンクは site_info（CMS）に URL があるものだけを出す。
 */
import type { SiteInfo } from "../../lib/cms/types";
import LocalImage from "../ui/LocalImage.astro";
import { footerItems } from "../../config/site";
import { DEFAULT_PAGE_VISIBILITY } from "../../config/pages";
import { withBase } from "../../lib/url";
import earth from "../../assets/illustrations/earth.webp";
import Logo from "./Logo.astro";
import NavMark from "../ui/NavMark.astro";

interface Props {
  siteInfo?: SiteInfo | null;
  variant?: "earth" | "plain";
}

const { siteInfo, variant = "earth" } = Astro.props;
const sns = [
  { label: "Instagram", href: siteInfo?.instagramUrl ?? null },
  { label: "X", href: siteInfo?.xUrl ?? null },
].filter((item): item is { label: string; href: string } => item.href !== null);
---

<footer class:list={["site-footer", `is-${variant}`]}>
  {variant === "earth" && <LocalImage src={earth} alt="" class="site-footer__earth" aria-hidden="true" loading="lazy" />}
  <div class="site-footer__inner">
    <a class="site-footer__logo" href={withBase("/")} aria-label="合同会社ami トップページ">
      <Logo variant={variant === "earth" ? "white" : "color"} height={36} />
    </a>
    <nav aria-label="フッターメニュー">
      <ul class="site-footer__list">
        {
          footerItems(siteInfo?.pageVisibility ?? DEFAULT_PAGE_VISIBILITY).map((item) => (
            <li>
              <a class="site-footer__link" href={withBase(item.href)}>
                <NavMark />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      sns.length > 0 && (
        <ul class="site-footer__sns" aria-label="公式 SNS">
          {sns.map((item) => (
            <li>
              <a class="site-footer__sns-link" href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
                <span class="visually-hidden">（新しいタブで開く）</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    /* デザインのフッター部分（幅 1280 / 高さ 633）の比率を保つ */
    aspect-ratio: 1280 / 633;
    min-height: 280px;
  }

  /* デザインの地球の大きさ（幅 1566 / 1280）と位置（上端がフッター上端から約 11px）に合わせる */
  .site-footer__earth {
    position: absolute;
    left: 50%;
    top: 1.7%;
    width: max(122.3%, 760px);
    max-width: none;
    translate: -50% 0;
  }

  .site-footer__inner {
    position: absolute;
    inset: auto 0 24%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 23px;
    padding-inline: var(--gutter);
    color: #fff;
    filter: drop-shadow(0 0 4.65px rgb(0 0 0 / 0.51));
  }

  .site-footer__logo {
    display: flex;
    text-decoration: none;
  }

  .site-footer__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 42px;
  }

  .site-footer__link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-pixel);
    font-size: 20px;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__sns {
    display: flex;
    flex-basis: 100%;
    justify-content: center;
    gap: 12px;
  }

  .site-footer__sns-link {
    display: block;
    padding: 6px 16px;
    font-family: var(--font-pixel);
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    border: 2px solid currentColor;
    border-radius: 999px;
    transition:
      color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .site-footer__sns-link:hover {
    color: var(--color-border);
    background: #fff;
  }

  /* plain: 地球を出さず、文字の並びは同じまま黒にする。地は SkySection と同じ淡い斜線 */
  .site-footer.is-plain {
    aspect-ratio: auto;
    min-height: 0;
    padding-block: 24px 72px;
    background: repeating-linear-gradient(135deg, #f6fdff 0 7.07px, #f1f8fa 7.07px 14.14px);
  }

  .site-footer.is-plain .site-footer__inner {
    position: static;
    color: var(--color-text);
    filter: none;
  }

  .site-footer.is-plain .site-footer__sns-link:hover {
    color: #fff;
    background: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__sns-link {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      aspect-ratio: auto;
      height: 380px;
    }

    .site-footer__earth {
      top: 60px;
    }

    .site-footer__inner {
      flex-direction: column;
      bottom: 64px;
    }

    .site-footer.is-plain {
      height: auto;
      padding-block: 16px 56px;
    }

    .site-footer__list {
      gap: 8px 24px;
    }
  }
</style>

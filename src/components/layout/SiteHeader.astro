---
/**
 * ヘッダー。PC はナビを横に並べ、スマホ・タブレットはメニューボタンで開閉する。
 */
import { NAV_ITEMS } from "../../config/site";
import { withBase } from "../../lib/url";
import Logo from "./Logo.astro";
import NavMark from "../ui/NavMark.astro";
---

<header class="site-header" data-site-header>
  <nav class="site-header__nav" id="site-nav" aria-label="メインメニュー">
    <ul class="site-header__list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a class="site-header__link" href={withBase(item.href)}>
              <NavMark />
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="site-header__logo" href={withBase("/")} aria-label="合同会社ami トップページ">
    <Logo height={36} />
  </a>

  <button
    class="site-header__toggle"
    type="button"
    aria-controls="site-nav"
    aria-expanded="false"
    data-nav-toggle
  >
    <span class="site-header__toggle-bars" aria-hidden="true"></span>
    <span class="visually-hidden" data-nav-toggle-label>メニューを開く</span>
  </button>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const label = header?.querySelector<HTMLElement>("[data-nav-toggle-label]");

  function setOpen(open: boolean) {
    if (!header || !toggle || !label) return;
    header.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "メニューを閉じる" : "メニューを開く";
    document.documentElement.classList.toggle("is-nav-open", open);
  }

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  // ページ内リンクで移動したら閉じる
  header?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  // PC 幅に戻ったら閉じた状態に戻す
  matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    color: var(--color-text);
    background: var(--color-surface);
  }

  .site-header__list {
    display: flex;
    height: 100%;
  }

  .site-header__nav {
    height: 100%;
  }

  .site-header__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    width: 170px;
    height: var(--header-height);
    border-right: 2px solid var(--color-border);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .site-header__link:hover {
    color: #fff;
    background: var(--color-bg-2);
  }

  .site-header__logo {
    display: flex;
    margin-right: 23px;
    text-decoration: none;
  }

  .site-header__toggle {
    display: none;
  }

  /* ---- タブレット・スマホ: メニューボタンで開閉 ---- */
  @media (max-width: 1023px) {
    .site-header {
      padding-inline: var(--gutter);
    }

    .site-header__logo {
      order: -1;
      margin-right: 0;
    }

    .site-header__toggle {
      position: relative;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    /* ドット風の三本線 → × */
    .site-header__toggle-bars,
    .site-header__toggle-bars::before,
    .site-header__toggle-bars::after {
      display: block;
      width: 24px;
      height: 3px;
      background: currentColor;
      transition:
        rotate var(--duration-base) var(--ease-out),
        translate var(--duration-base) var(--ease-out),
        opacity var(--duration-base);
    }

    .site-header__toggle-bars {
      position: relative;
    }

    .site-header__toggle-bars::before,
    .site-header__toggle-bars::after {
      content: "";
      position: absolute;
      left: 0;
    }

    .site-header__toggle-bars::before {
      translate: 0 -8px;
    }

    .site-header__toggle-bars::after {
      translate: 0 8px;
    }

    .is-open .site-header__toggle-bars {
      background: transparent;
    }

    .is-open .site-header__toggle-bars::before {
      translate: 0;
      rotate: 45deg;
    }

    .is-open .site-header__toggle-bars::after {
      translate: 0;
      rotate: -45deg;
    }

    .site-header__nav {
      position: fixed;
      inset: var(--header-height) 0 0;
      height: auto;
      padding: 40px var(--gutter);
      background: var(--gradient-hero);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-base) var(--ease-out),
        visibility var(--duration-base);
    }

    .is-open .site-header__nav {
      opacity: 1;
      visibility: visible;
    }

    .site-header__list {
      flex-direction: column;
      gap: 8px;
      height: auto;
    }

    .site-header__link {
      justify-content: flex-start;
      width: 100%;
      height: 64px;
      padding-inline: 16px;
      border-right: 0;
      border-bottom: 2px solid rgb(255 255 255 / 0.25);
      font-size: 20px;
      color: #fff;
    }

    .site-header__link:hover {
      background: rgb(255 255 255 / 0.08);
    }
  }
</style>

<style is:global>
  html.is-nav-open {
    overflow: hidden;
  }
</style>

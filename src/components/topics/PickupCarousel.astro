---
/**
 * TOPICS 一覧の「Pick UP!」（Figma: topics / Pick UP!）。CMS で pickup を付けた記事を、光る枠のパネルで横に並べる。
 * 真ん中の 1 枚をはっきり見せ、左右は薄く見せる（横にスクロール / スワイプで送る。操作が無いときは自動で送る）。
 * 枠の形（角のドット）はデザインの path をそのまま使う（src/assets/shapes/pickup-panel.json）。
 */
import type { Topic } from "../../lib/cms/types";
import { TOPIC_CATEGORY_LABEL, formatTopicDate, topicHref } from "../../lib/topics";
import CmsImage from "../ui/CmsImage.astro";
import LocalImage from "../ui/LocalImage.astro";
import panel from "../../assets/shapes/pickup-panel.json";
import label from "../../assets/decor/pickup-label.webp";
import thumbsUp from "../../assets/icons/thumbs-up.webp";
import arrow from "../../assets/icons/arrow-circle.webp";

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

{
  topics.length > 0 && (
    <section class="pickup" aria-labelledby="pickup-title">
      <div class="stage pickup__stage">
        <div class="pickup__label">
          <LocalImage src={label} alt="" loading="eager" />
          <h2 class="pickup__title" id="pickup-title">Pick UP!</h2>
        </div>
      </div>

      <div class:list={["pickup__track", topics.length === 1 && "is-single"]} data-pickup tabindex="0" aria-label="Pick UP! の記事（横にスクロールできます）">
        <ul class="pickup__list">
          {topics.map((topic, i) => {
            const { href, external } = topicHref(topic);
            const categoryLabel = TOPIC_CATEGORY_LABEL[topic.category];
            return (
              <li class:list={["pickup__item", `is-${topic.category}`]} data-active={i === 0 ? "" : undefined}>
                <svg class="pickup__frame" viewBox={panel.viewBox} preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <path d={panel.fill} fill="#041049" />
                  <path d={panel.stroke} fill="none" stroke="#00E6FF" stroke-width="4" vector-effect="non-scaling-stroke" />
                </svg>
                <a
                  class="pickup__link"
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  <div class="pickup__photo">
                    <div class="pickup__photo-inner">
                      {topic.thumbnail && <CmsImage media={topic.thumbnail} photo loading={i === 0 ? "eager" : "lazy"} />}
                    </div>
                    <LocalImage src={thumbsUp} alt="" class="pickup__thumbs" />
                  </div>
                  <div class="pickup__text">
                    <p class="pickup__meta">
                      <span class="pickup__category">{categoryLabel}</span>
                      <time datetime={topic.publishedDate}>{formatTopicDate(topic.publishedDate)}</time>
                    </p>
                    <h3 class="pickup__heading">
                      {topic.title}
                      {external && <span class="visually-hidden">（外部サイトが開きます）</span>}
                    </h3>
                    {topic.excerpt && <p class="pickup__excerpt">{topic.excerpt}</p>}
                    <LocalImage src={arrow} alt="" class="pickup__arrow" />
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<script>
  // 真ん中に来たパネルだけをはっきり見せる（JS が無いときはすべて同じ濃さ）
  for (const track of document.querySelectorAll<HTMLElement>("[data-pickup]")) {
    const items = [...track.querySelectorAll<HTMLElement>(".pickup__item")];
    track.classList.add("is-enhanced");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.toggleAttribute("data-active", e.intersectionRatio >= 0.6);
      },
      { root: track, threshold: [0, 0.6, 1] },
    );
    items.forEach((item) => io.observe(item));
    autoAdvance(track, items);
  }

  /*
   * 操作が無いときは、数秒ごとに次のパネルへ自動で送る（最後まで行ったら先頭へ戻る）。
   * マウスを乗せている間・フォーカスがある間・触ってからしばらくは止める。画面に見えていないとき、
   * prefers-reduced-motion のときは動かさない。
   */
  function autoAdvance(track: HTMLElement, items: HTMLElement[]) {
    const INTERVAL = 4500;
    const IDLE_AFTER_INPUT = 6000;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    if (items.length < 2) return;

    let hovering = false;
    let visible = false;
    let lastInput = 0;
    const markInput = () => (lastInput = Date.now());

    track.addEventListener("pointerenter", () => (hovering = true));
    track.addEventListener("pointerleave", () => {
      hovering = false;
      markInput();
    });
    for (const type of ["pointerdown", "wheel", "touchstart", "keydown"]) {
      track.addEventListener(type, markInput, { passive: true });
    }
    new IntersectionObserver(([e]) => (visible = e!.isIntersecting)).observe(track);

    // 真ん中に一番近いパネル
    const currentIndex = () => {
      const r = track.getBoundingClientRect();
      const center = r.left + r.width / 2;
      let best = 0;
      let bestDist = Infinity;
      items.forEach((item, i) => {
        const ir = item.getBoundingClientRect();
        const d = Math.abs(ir.left + ir.width / 2 - center);
        if (d < bestDist) [best, bestDist] = [i, d];
      });
      return best;
    };

    setInterval(() => {
      if (reduce.matches || !visible || hovering || document.hidden) return;
      if (track.contains(document.activeElement)) return;
      if (Date.now() - lastInput < IDLE_AFTER_INPUT) return;
      const next = items[(currentIndex() + 1) % items.length]!;
      const tr = track.getBoundingClientRect();
      const nr = next.getBoundingClientRect();
      track.scrollBy({ left: nr.left + nr.width / 2 - (tr.left + tr.width / 2), behavior: "smooth" });
    }, INTERVAL);
  }
</script>

<style>
  /*
   * 位置と大きさは Figma（topics）の値。ラベル y=430、パネル 847×345 が y=494（ラベルの 64 下）。
   * 光（drop-shadow）が切れないよう、横スクロールの枠に上下 32 の余白を取り、その分だけ全体を詰める。
   */
  .pickup {
    --panel-w: clamp(300px, calc(847 / 12.8 * 1vw), 847px);
    --gap: clamp(20px, calc(42 / 12.8 * 1vw), 42px);
    position: relative;
    z-index: var(--z-content);
    padding-top: calc(32 / 847 * var(--panel-w));
  }

  .pickup__stage {
    height: 0;
  }

  .pickup__label {
    position: absolute;
    z-index: 2;
    top: calc(-32 / 847 * var(--panel-w));
    left: calc(50% - var(--panel-w) / 2 - 25 / 847 * var(--panel-w));
    width: calc(322 / 847 * var(--panel-w));
    line-height: 0;
    pointer-events: none;
  }

  .pickup__label :global(img) {
    width: 100%;
    height: auto;
  }

  .pickup__title {
    position: absolute;
    top: 49.5%;
    left: 51.6%;
    translate: -50% -50%;
    font-family: var(--font-pixel);
    font-size: clamp(14px, calc(20 / 12.8 * 1vw), 20px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #c8ecf6;
  }

  .pickup__track {
    overflow-x: auto;
    padding-block: 32px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pickup__track::-webkit-scrollbar {
    display: none;
  }

  .pickup__track:focus-visible {
    outline-offset: -4px;
  }

  .pickup__list {
    display: flex;
    gap: var(--gap);
    width: max-content;
    padding-inline: calc((100vw - var(--panel-w)) / 2);
  }

  .pickup__item {
    position: relative;
    width: var(--panel-w);
    aspect-ratio: 847 / 345;
    scroll-snap-align: center;
    filter: drop-shadow(0 0 14px rgb(0 255 251 / 0.8));
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .pickup__track.is-enhanced .pickup__item:not([data-active]) {
    opacity: 0.43;
  }

  .pickup__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pickup__link {
    position: relative;
    display: grid;
    /* 列・間の % は padding を除いた幅（847 - 58 - 56 = 733）が基準 */
    grid-template-columns: calc(348 / 733 * 100%) 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: calc(22 / 733 * 100%);
    height: 100%;
    /* padding の % は幅が基準（上下も 847 で割る） */
    padding: calc(40 / 847 * 100%) calc(56 / 847 * 100%) calc(41 / 847 * 100%) calc(58 / 847 * 100%);
    color: #c8ecf6;
    text-decoration: none;
  }

  .pickup__photo {
    position: relative;
    border: 2px solid #51e3ee;
    background: #041049;
  }

  .pickup__photo-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .pickup__photo-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .pickup__photo :global(.pickup__thumbs) {
    position: absolute;
    left: calc(-24 / 348 * 100%);
    bottom: calc(-12 / 264 * 100%);
    width: calc(53 / 348 * 100%);
    height: auto;
  }

  .pickup__text {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pickup__meta {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-pixel);
    font-size: clamp(11px, calc(15 / 12.8 * 1vw), 15px);
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--pill-bg);
  }

  .pickup__item {
    --pill-bg: #02b7e9;
    --pill-fg: #c8ecf6;
  }

  .pickup__item.is-sns {
    --pill-bg: #a26ae7;
    --pill-fg: #edc8f6;
  }

  .pickup__item.is-column {
    --pill-bg: #53df7f;
    --pill-fg: #d4f6c8;
  }

  .pickup__category {
    display: grid;
    place-items: center;
    width: 136px;
    height: 38.5px;
    font-size: clamp(12px, calc(17 / 12.8 * 1vw), 17px);
    color: var(--pill-fg);
    background: var(--pill-bg);
    mask: url("../../assets/shapes/pixel-pill.svg") center / 100% 100% no-repeat;
  }

  .pickup__heading {
    margin-top: clamp(12px, calc(25 / 12.8 * 1vw), 25px);
    font-size: clamp(16px, calc(22 / 12.8 * 1vw), 22px);
    font-weight: 400;
    line-height: 1.36;
    letter-spacing: 0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pickup__excerpt {
    margin-top: clamp(8px, calc(13 / 12.8 * 1vw), 13px);
    font-size: clamp(12px, calc(15 / 12.8 * 1vw), 15px);
    line-height: 1.73;
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pickup__text :global(.pickup__arrow) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(24px, calc(31 / 12.8 * 1vw), 31px);
    height: auto;
    transition: translate var(--duration-base) var(--ease-out);
  }

  .pickup__link:hover :global(.pickup__arrow) {
    translate: 4px 0;
  }

  .pickup__link:focus-visible {
    outline-offset: 6px;
  }

  @media (max-width: 767px) {
    .pickup {
      --panel-w: min(86vw, 360px);
    }

    .pickup__item {
      aspect-ratio: auto;
    }

    .pickup__link {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 28px 20px 24px;
    }

    .pickup__photo {
      aspect-ratio: 348 / 264;
    }

    .pickup__label {
      width: 200px;
      left: calc(50% - var(--panel-w) / 2 - 12px);
    }

    .pickup__text {
      padding-bottom: 36px;
    }
  }
</style>

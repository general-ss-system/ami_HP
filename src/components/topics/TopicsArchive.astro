---
/**
 * TOPICS 一覧の中身（分類のタブ・カード・ページ送り）。ページ番号・分類ごとのルートから共通で使う。
 */
import PageLayout from "../../layouts/PageLayout.astro";
import TopicCard from "../sections/TopicCard.astro";
import Decor from "../ui/Decor.astro";
import FilterTabs, { type FilterTab } from "../ui/FilterTabs.astro";
import Pager from "../ui/Pager.astro";
import { TOPIC_CATEGORIES } from "../../lib/cms/schemas";
import type { TopicsArchiveData } from "../../lib/cms/queries";
import { TOPIC_CATEGORY_LABEL, topicsListHref } from "../../lib/topics";
import { pageDescription, pageTitle } from "../../lib/seo";
import sparkleCluster from "../../assets/decor/sparkle-cluster.webp";
import planetBunnyBlue from "../../assets/decor/planet-bunny-blue.webp";
import rocketBunny from "../../assets/decor/rocket-bunny.webp";

interface Props {
  data: TopicsArchiveData;
}

const { siteInfo, topics, category, page, totalPages } = Astro.props.data;

const categoryLabel = category ? TOPIC_CATEGORY_LABEL[category] : null;
const titleParts = ["Topics", categoryLabel, page > 1 ? `${page}ページ目` : null].filter(Boolean);

// 選んでいる分類は、カードと同じ色の地にする
const tabs: FilterTab[] = [
  { key: "all", label: "ALL", href: topicsListHref(null), current: category === null },
  ...TOPIC_CATEGORIES.map((c) => ({
    key: c,
    label: TOPIC_CATEGORY_LABEL[c],
    href: topicsListHref(c),
    current: category === c,
    from: `var(--color-topic-${c}-from)`,
    to: `var(--color-topic-${c}-to)`,
  })),
];

const crumbs = [
  { label: "TOPICS", href: category || page > 1 ? topicsListHref(null) : undefined },
  ...(categoryLabel ? [{ label: categoryLabel, href: page > 1 ? topicsListHref(category) : undefined }] : []),
  ...(page > 1 ? [{ label: `${page}ページ目` }] : []),
];
---

<PageLayout
  siteInfo={siteInfo}
  title={pageTitle(siteInfo, titleParts.join(" / "))}
  description={pageDescription(siteInfo)}
  heading="Topics"
  headingSub="お知らせ・SNS・コラム"
  crumbs={crumbs}
>
  <section class="topics-archive" aria-label="記事の一覧">
    <div class="stage topics-archive__stage">
      <FilterTabs tabs={tabs} label="分類で絞り込む" latin />

      {
        topics.length > 0 ? (
          <ul class="topics-archive__list">
            {topics.map((topic) => (
              <li class="topics-archive__item">
                <TopicCard topic={topic} headingLevel={2} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="topics-archive__empty">まだ記事がありません。</p>
        )
      }

      <Pager page={page} totalPages={totalPages} hrefFor={(n) => topicsListHref(category, n)} />

      <Decor src={sparkleCluster} pc={[1080, 0, 170]} sp={false} twinkle delay={0.4} />
      <Decor src={planetBunnyBlue} pc={[30, 560, 130]} sp={false} float delay={1.1} />
      <Decor src={rocketBunny} pc={[1110, 900, 170]} sp={false} float delay={2} />
    </div>
  </section>
</PageLayout>

<style>
  .topics-archive__stage {
    padding: 0 var(--gutter) clamp(96px, 12.5vw, 160px);
  }

  .topics-archive__list {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    grid-template-columns: repeat(3, 305px);
    justify-content: center;
    gap: 72px clamp(32px, 4.7vw, 60px);
    margin-top: clamp(56px, 6.25vw, 80px);
  }

  .topics-archive__item {
    display: flex;
    justify-content: center;
  }

  /* トップと同じく少しずつ傾けて並べる（控えめに） */
  .topics-archive__item:nth-child(3n + 1) {
    rotate: -2deg;
  }

  .topics-archive__item:nth-child(3n + 3) {
    rotate: 2deg;
  }

  .topics-archive__empty {
    position: relative;
    z-index: var(--z-content);
    margin-top: 64px;
    text-align: center;
  }

  @media (max-width: 1099px) {
    .topics-archive__list {
      grid-template-columns: repeat(2, 305px);
    }
  }

  @media (max-width: 767px) {
    .topics-archive__list {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .topics-archive__item {
      rotate: 0deg !important;
    }
  }
</style>

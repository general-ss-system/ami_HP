---
/**
 * お問い合わせへの誘導。案内文は CMS（ami_home.contact_body）、ボタンはコード。
 */
import LocalImage from "../ui/LocalImage.astro";
import Decor from "../ui/Decor.astro";
import pillBg from "../../assets/backgrounds/business-pill.webp";
import astronautBunny from "../../assets/decor/astronaut-bunny.webp";
import planetRinged from "../../assets/decor/planet-ringed.webp";
import sparkleGold from "../../assets/decor/sparkle-gold.webp";

interface Props {
  body: string | null;
  href: string;
}

const { body, href } = Astro.props;
const lines = body ? body.replace(/\r\n?/g, "\n").split("\n") : [];
---

<section class="contact-cta" aria-label="お問い合わせ">
  <div class="stage contact-cta__stage">
    {
      lines.length > 0 && (
        <p class="contact-cta__body">
          {lines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )
    }

    <p class="contact-cta__action">
      <a class="contact-cta__button" href={href}>
        <LocalImage src={pillBg} alt="" class="contact-cta__button-bg" aria-hidden="true" />
        <span class="contact-cta__button-label">お問い合わせはこちら<span aria-hidden="true"> ➡</span></span>
        <LocalImage src={astronautBunny} alt="" class="contact-cta__bunny" aria-hidden="true" />
      </a>
    </p>

    <Decor src={planetRinged} pc={[95, 40, 80]} sp={[12, 0, 48]} float delay={0.9} />
    <Decor src={sparkleGold} pc={[222, 165, 60]} sp={false} twinkle delay={0.3} />
    <Decor src={sparkleGold} pc={[1069, 502, 60]} sp={[24, 300, 30]} twinkle delay={1.8} />
  </div>
</section>

<style>
  .contact-cta__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(80px, 10vw, 128px) var(--gutter) clamp(48px, 7.0312vw, 90px);
  }

  .contact-cta__body {
    position: relative;
    z-index: var(--z-content);
    font-size: clamp(16px, 1.7188vw, 22px);
    line-height: 48px;
    letter-spacing: 0.2em;
    text-align: center;
    text-shadow: 1px 2px 0 rgb(4 16 74 / 0.4);
  }

  @media (max-width: 767px) {
    .contact-cta__body {
      font-size: 15px;
      letter-spacing: 0.08em;
    }
  }

  .contact-cta__action {
    position: relative;
    z-index: var(--z-content);
    margin-top: clamp(48px, 5.625vw, 72px);
  }

  .contact-cta__button {
    position: relative;
    display: grid;
    place-items: center;
    width: min(411px, 84vw);
    height: 53px;
    padding-right: 40px;
    text-decoration: none;
    color: #fff;
    border: 2px solid #fff;
    border-radius: 999px;
    background: linear-gradient(90deg, #4758bd 0%, #6a5bd6 55%, #967adf 100%);
    transition:
      translate var(--duration-base) var(--ease-out),
      filter var(--duration-base) var(--ease-out);
  }

  .contact-cta__button:hover {
    translate: 0 -3px;
    filter: brightness(1.12);
  }

  .contact-cta__button-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
    border-radius: inherit;
    /* 星のきらめきだけを重ねる */
    mix-blend-mode: screen;
    opacity: 0.35;
  }

  .contact-cta__button-label {
    position: relative;
    font-size: clamp(16px, 1.5625vw, 20px);
    letter-spacing: 0.14em;
  }

  .contact-cta__bunny {
    position: absolute;
    right: -50px;
    top: 50%;
    width: 104px;
    translate: 0 -58%;
    animation: bunny-wave 3s ease-in-out infinite;
  }

  @keyframes bunny-wave {
    50% {
      rotate: -8deg;
    }
  }
</style>

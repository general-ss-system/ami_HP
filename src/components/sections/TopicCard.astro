---
/**
 * Topics のカード。分類（NEWS / SNS / COLUMN）で色が変わる。
 * ハート・吹き出しはデザイン上の飾り（件数などは持たない）。
 */
import type { Topic } from "../../lib/cms/types";
import CmsImage from "../ui/CmsImage.astro";

interface Props {
  topic: Topic;
  href: string;
}

const { topic, href } = Astro.props;

const CATEGORY_LABEL = { news: "NEWS", sns: "SNS", column: "COLUMN" } as const;
---

<article class:list={["topic-card", `is-${topic.category}`]}>
  <a class="topic-card__link" href={href}>
    <span class="topic-card__sheet is-top" aria-hidden="true"></span>
    <span class="topic-card__sheet is-bottom" aria-hidden="true"></span>

    <div class="topic-card__head">
      <p class="topic-card__category">{CATEGORY_LABEL[topic.category]}</p>
      <svg class="topic-card__bookmark" viewBox="0 0 8 10" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
        <path d="M0 0h8v10L4 7 0 10z" />
      </svg>
    </div>

    <div class="topic-card__thumb">
      {topic.thumbnail && <CmsImage media={topic.thumbnail} photo />}
    </div>

    <h3 class="topic-card__title">{topic.title}</h3>
    {topic.excerpt && <p class="topic-card__excerpt">{topic.excerpt}</p>}

    <p class="topic-card__icons" aria-hidden="true">
      <svg viewBox="0 0 9 8" class="topic-card__heart" shape-rendering="crispEdges">
        <path d="M1 0h2v1h1v1h1V1h1V0h2v1h1v3H8v1H7v1H6v1H5v1H4V7H3V6H2V5H1V4H0V1h1z" />
      </svg>
      <svg viewBox="0 0 10 9" class="topic-card__comment" shape-rendering="crispEdges">
        <path d="M2 0h6v1h1v1h1v4H9v1H8v1H4v1H2V7H1V6H0V2h1V1h1zm0 1v1H1v4h1v1h1v1h1V7h4V6h1V2H8V1z" />
      </svg>
    </p>
    <time class="visually-hidden" datetime={topic.publishedDate}>{topic.publishedDate}</time>
  </a>
</article>

<style>
  .topic-card {
    --from: var(--color-topic-news-from);
    --to: var(--color-topic-news-to);
    position: relative;
    flex: none;
    width: clamp(260px, 27cqw, 344px);
  }

  .topic-card.is-sns {
    --from: var(--color-topic-sns-from);
    --to: var(--color-topic-sns-to);
  }

  .topic-card.is-column {
    --from: var(--color-topic-column-from);
    --to: var(--color-topic-column-to);
  }

  .topic-card__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 26px;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(110deg, var(--from), var(--to));
    box-shadow: 0 10px 24px rgb(20 10 80 / 0.25);
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .topic-card__link:hover {
    translate: 0 -6px;
    box-shadow: 0 18px 32px rgb(20 10 80 / 0.35);
  }

  /* 紙が重なったように見せる白い縁 */
  .topic-card__sheet {
    position: absolute;
    left: 4%;
    right: -2%;
    height: 8px;
    background: #fff;
    z-index: -1;
  }

  .topic-card__sheet.is-top {
    top: -6px;
  }

  .topic-card__sheet.is-bottom {
    bottom: -6px;
    left: 6%;
    right: 2%;
  }

  .topic-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topic-card__category {
    font-size: clamp(20px, 1.9vw, 24px);
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  .topic-card__bookmark {
    width: 16px;
    fill: rgb(255 255 255 / 0.75);
  }

  .topic-card__thumb {
    aspect-ratio: 262 / 170;
    margin-top: 12px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.3);
  }

  .topic-card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .topic-card__title {
    margin-top: 18px;
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .topic-card__excerpt {
    display: -webkit-box;
    margin-top: 4px;
    overflow: hidden;
    font-size: var(--fs-sm);
    line-height: 1.7;
    letter-spacing: 0.04em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .topic-card__icons {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
  }

  .topic-card__icons svg {
    width: 18px;
    height: 16px;
  }

  .topic-card__heart {
    fill: var(--color-heart);
  }

  .topic-card__comment {
    fill: #fff;
  }
</style>

---
/**
 * Our Business（SERVICE）。事業は CMS（ami_services）。
 * 画像は角丸の枠の上にはみ出して見せる。背景を透過した縦長（約 3:5）の画像を想定。
 */
import type { Service } from "../../lib/cms/types";
import Decor from "../ui/Decor.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ServiceVisual from "../ui/ServiceVisual.astro";
import ViewMore from "../ui/ViewMore.astro";
import heading from "../../assets/headings/our-business.webp";
import planetRinged from "../../assets/decor/planet-ringed.webp";
import planetBunnyBlue from "../../assets/decor/planet-bunny-blue.webp";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

{
  services.length > 0 && (
    <section class="business" id="service" aria-labelledby="business-title">
      <div class="stage business__stage">
        <SectionHeading src={heading} text="Our Business" width={450} id="business-title" />

        <ul class="business__list">
          {services.map((service) => (
            <li class="business__item">
              <ServiceVisual image={service.image} />
              <h3 class="business__title">{service.title}</h3>
              {service.summary && <p class="business__summary">{service.summary}</p>}
              {service.link && <ViewMore link={service.link} context={service.title} />}
            </li>
          ))}
        </ul>

        <Decor src={planetRinged} pc={[-4, 693, 162]} sp={false} float delay={0.6} />
        <Decor src={planetBunnyBlue} pc={[1163, 1086, 148]} sp={[300, -20, 70]} float delay={1.6} />
      </div>
    </section>
  )
}

<style>
  .business__stage {
    padding-block: clamp(40px, 5.2344vw, 67px) clamp(64px, 7.0313vw, 90px);
  }

  .business__list {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(56px, 6.25vw, 80px) clamp(48px, 11.4cqw, 146px);
    margin-top: clamp(60px, 6.25vw, 80px);
    padding-inline: var(--gutter);
  }

  .business__item {
    display: flex;
    flex-direction: column;
    width: min(100%, 354px);
  }

  .business__title {
    margin-top: 50px;
    font-size: clamp(20px, 1.875vw, 24px);
    font-weight: 400;
    line-height: 1;
    color: var(--color-accent-bright);
    letter-spacing: 0.02em;
  }

  .business__summary {
    margin-top: 20px;
    font-size: 15px;
    line-height: 25px;
  }

  .business__item :global(.view-more) {
    margin-top: 20px;
  }
</style>

---
/**
 * Our Business（SERVICE）。事業は CMS（ami_services）。
 * 画像は角丸の枠の上にはみ出して見せる。背景を透過した縦長（約 3:5）の画像を想定。
 */
import LocalImage from "../ui/LocalImage.astro";
import type { Service } from "../../lib/cms/types";
import CmsImage from "../ui/CmsImage.astro";
import Decor from "../ui/Decor.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ViewMore from "../ui/ViewMore.astro";
import heading from "../../assets/headings/our-business.webp";
import pillBg from "../../assets/backgrounds/business-pill.webp";
import sparkle from "../../assets/icons/sparkle-light.webp";
import planetRinged from "../../assets/decor/planet-ringed.webp";
import planetBunnyBlue from "../../assets/decor/planet-bunny-blue.webp";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

{
  services.length > 0 && (
    <section class="business" id="service" aria-labelledby="business-title">
      <div class="stage business__stage">
        <SectionHeading src={heading} text="Our Business" width={450} id="business-title" />

        <ul class="business__list">
          {services.map((service) => (
            <li class="business__item">
              <div class="business__visual">
                <span class="business__sparkles" aria-hidden="true">
                  <LocalImage src={sparkle} alt="" />
                  <LocalImage src={sparkle} alt="" />
                </span>
                <div class="business__pill">
                  <LocalImage src={pillBg} alt="" class="business__pill-bg" aria-hidden="true" />
                  {service.image && <CmsImage media={service.image} class="business__image" />}
                </div>
                <span class="business__sparkles" aria-hidden="true">
                  <LocalImage src={sparkle} alt="" />
                  <LocalImage src={sparkle} alt="" />
                </span>
              </div>
              <h3 class="business__title">{service.title}</h3>
              {service.summary && <p class="business__summary">{service.summary}</p>}
              {service.link && <ViewMore link={service.link} context={service.title} />}
            </li>
          ))}
        </ul>

        <Decor src={planetRinged} pc={[-4, 693, 162]} sp={false} float delay={0.6} />
        <Decor src={planetBunnyBlue} pc={[1163, 1086, 148]} sp={[300, -20, 70]} float delay={1.6} />
      </div>
    </section>
  )
}

<style>
  .business__stage {
    padding-block: clamp(40px, 5.2344vw, 67px) clamp(64px, 7.0313vw, 90px);
  }

  .business__list {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(56px, 6.25vw, 80px) clamp(48px, 11.4cqw, 146px);
    margin-top: clamp(60px, 6.25vw, 80px);
    padding-inline: var(--gutter);
  }

  .business__item {
    display: flex;
    flex-direction: column;
    width: min(100%, 354px);
  }

  .business__visual {
    display: grid;
    gap: 19px;
  }

  .business__visual > :last-child {
    margin-top: 11px;
  }

  .business__sparkles {
    display: flex;
    justify-content: space-between;
  }

  .business__sparkles :global(img) {
    width: 30px;
  }

  .business__pill {
    position: relative;
    width: 88.4%;
    aspect-ratio: 313 / 461;
    margin-inline: auto;
  }

  .business__pill-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
  }

  /*
   * 枠より縦に長い箱に、縦横比を保って下揃えで収める（上にはみ出して見える）。
   * 画像は透明な余白を含まない透過 PNG を想定。
   */
  .business__pill :global(.business__image) {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 92%;
    height: 110%;
    max-width: none;
    translate: -50% 0;
    object-fit: contain;
    object-position: center bottom;
    image-rendering: auto;
    filter: drop-shadow(0 12px 18px rgb(10 10 60 / 0.35));
  }

  .business__title {
    margin-top: 50px;
    font-size: clamp(20px, 1.875vw, 24px);
    font-weight: 400;
    line-height: 1;
    color: var(--color-accent-bright);
    letter-spacing: 0.02em;
  }

  .business__summary {
    margin-top: 20px;
    font-size: 15px;
    line-height: 25px;
  }

  .business__item :global(.view-more) {
    margin-top: 20px;
  }
</style>

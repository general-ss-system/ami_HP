---
/**
 * Topics。最新の記事を CMS（ami_topics）から件数（ami_home.topics_limit）分並べる。
 * カードは少しずつ傾けて並べ、画面からはみ出す分は横にスクロールできる。
 */
import type { Topic } from "../../lib/cms/types";
import Decor from "../ui/Decor.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ViewMore from "../ui/ViewMore.astro";
import TopicCard from "./TopicCard.astro";
import heading from "../../assets/headings/topics.webp";
import sparkleCluster from "../../assets/decor/sparkle-cluster.webp";

interface Props {
  topics: Topic[];
  /** 一覧ページへのリンク。未指定なら出さない。 */
  moreHref?: string;
}

const { topics, moreHref } = Astro.props;
---

{
  topics.length > 0 && (
    <section class="topics" id="topics" aria-labelledby="topics-title">
      <div class="stage topics__stage">
        <SectionHeading src={heading} text="Topics" width={212} id="topics-title" />

        <div class="topics__scroller" tabindex="0" aria-label="Topics の一覧（横にスクロールできます）">
          <ul class="topics__list">
            {topics.map((topic) => (
              <li class="topics__item">
                <TopicCard topic={topic} />
              </li>
            ))}
          </ul>
        </div>

        {moreHref && (
          <div class="topics__more">
            <ViewMore link={{ label: "View more", href: moreHref, external: false }} context="Topics の一覧" />
          </div>
        )}

        <Decor src={sparkleCluster} pc={[67, 16, 200]} sp={[10, 10, 70]} twinkle delay={0.3} />
      </div>
    </section>
  )
}

<style>
  .topics__stage {
    padding-block: clamp(40px, 5.4688vw, 70px) clamp(48px, 5.0781vw, 65px);
  }

  .topics__scroller {
    position: relative;
    z-index: var(--z-content);
    margin-top: clamp(48px, 6.25vw, 80px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .topics__scroller::-webkit-scrollbar {
    display: none;
  }

  /* デザインでは 1 枚目のカードの左端が x=81、カードの間隔は約 80px */
  .topics__list {
    display: flex;
    gap: clamp(28px, 6.25cqw, 80px);
    width: max-content;
    /* 傾けたカードの角が切れないように上下に余白を取る */
    padding: 40px calc(81 / 12.8 * 1cqw) 48px;
  }

  .topics__more {
    position: relative;
    z-index: var(--z-content);
    width: min(100%, 1118px);
    margin: 8px auto 0;
    padding-inline: var(--gutter);
  }

  .topics__item {
    display: flex;
    scroll-snap-align: center;
  }

  /* デザインの傾き（Figma の値）を 4 枚周期で繰り返す */
  .topics__item:nth-child(4n + 1) {
    rotate: -5.35deg;
  }

  .topics__item:nth-child(4n + 3) {
    rotate: 5.44deg;
  }

  .topics__item:nth-child(4n + 4) {
    rotate: -2.6deg;
  }

  @media (max-width: 767px) {
    .topics__list {
      padding-inline: var(--gutter);
    }

    .topics__item {
      rotate: 0deg !important;
    }
  }
</style>

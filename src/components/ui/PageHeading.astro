---
/**
 * 下層ページの見出し。トップの英字見出し（白いステッカーにドット文字、1 文字目だけ水色）を
 * 文字で組んだもの。画像を用意しなくても見出しを増やせる。
 */

interface Props {
  /** 英字の見出し（例: "About"） */
  text: string;
  /** 日本語の添え書き（例: "私たちについて"） */
  sub?: string;
  /** h1（ページの見出し）か h2（ページ内の見出し） */
  level?: 1 | 2;
  /** 傾き（度） */
  tilt?: number;
  id?: string;
}

const { text, sub, level = 1, tilt = -3, id } = Astro.props;
const Tag = `h${level}` as "h1" | "h2";
---

<Tag class:list={["page-heading", `is-level-${level}`]} id={id} style={{ "--tilt": `${tilt}deg` }}>
  <span class="page-heading__sticker">
    <span class="page-heading__initial">{text.slice(0, 1)}</span>{text.slice(1)}
  </span>
  {sub && <span class="page-heading__sub">{sub}</span>}
</Tag>

<style>
  .page-heading {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    font-weight: 400;
  }

  .page-heading__sticker {
    display: inline-block;
    padding: 0.08em 0.32em 0.16em;
    font-family: var(--font-pixel);
    font-size: clamp(44px, 6.25vw, 80px);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-text);
    background: #fff;
    border: 4px solid var(--color-text);
    /* ドット絵の影（ぼかさない） */
    box-shadow:
      6px 6px 0 var(--color-text),
      -3px -3px 0 #fff;
    rotate: var(--tilt);
  }

  .is-level-2 .page-heading__sticker {
    font-size: clamp(34px, 4.22vw, 54px);
    border-width: 3px;
    box-shadow: 5px 5px 0 var(--color-text);
  }

  .page-heading__initial {
    color: var(--color-accent-bright);
    /* 水色の文字だけ、ドットの縁取り */
    text-shadow:
      2px 0 0 var(--color-accent),
      0 2px 0 var(--color-accent);
  }

  .page-heading__sub {
    font-size: var(--fs-sm);
    letter-spacing: var(--letter-spacing-wide);
    text-shadow: 1px 2px 0 rgb(4 16 74 / 0.4);
  }
</style>

---
/**
 * 手元の素材（src/assets）を表示する。
 *
 * SSR では画像の変換を行わない設定（runtime: passthrough）のため、astro:assets の <Image> を使うと
 * 変換用エンドポイント（/_image）を経由するだけで遅くなる。ビルド済みのファイル（/_astro/…、長期キャッシュ）を直接指す。
 * 素材は事前に WebP・適切なサイズにしておくこと（pnpm assets:webp）。
 * alt=""（装飾）のときは aria-hidden="true" も付け、読み上げの対象から外す。
 */
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "width" | "height"> {
  src: ImageMetadata;
  alt: string;
}

const { src, alt, loading = "lazy", decoding = "async", ...rest } = Astro.props;
---

<img
  src={src.src}
  alt={alt}
  width={src.width}
  height={src.height}
  loading={loading}
  decoding={decoding}
  aria-hidden={alt === "" ? "true" : undefined}
  {...rest}
/>

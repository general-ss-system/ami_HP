---
/**
 * 文章を読ませるための白い面。黒い線とドットの影で、ヘッダーや View more ボタンと同じ質感にする。
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "div" | "section" | "article";
}

const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag class:list={["panel", className]} {...rest}>
  <slot />
</Tag>

<style>
  .panel {
    position: relative;
    z-index: var(--z-content);
    padding: clamp(24px, 4.375vw, 56px) clamp(20px, 5vw, 64px);
    color: var(--color-text);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    box-shadow: 8px 8px 0 rgb(4 16 74 / 0.45);
  }

  @media (max-width: 767px) {
    .panel {
      box-shadow: 5px 5px 0 rgb(4 16 74 / 0.45);
    }
  }
</style>

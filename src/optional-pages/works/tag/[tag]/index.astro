---
/** WORKS 一覧（タグごと・1 ページ目）。 */
import type { GetStaticPaths } from "astro";
import WorksArchive from "../../../../components/works/WorksArchive.astro";
import { getCmsClient } from "../../../../lib/cms/env";
import { getWorksArchive, isWorkTag } from "../../../../lib/cms/queries";
import { WORK_TAGS } from "../../../../lib/cms/schemas";

// GitHub Pages のプレビュー（静的書き出し）で使う。本番（SSR）ではリクエストごとに解決する
export const getStaticPaths = (() => WORK_TAGS.map((tag) => ({ params: { tag } }))) satisfies GetStaticPaths;

const { tag } = Astro.params;
const data = isWorkTag(tag) ? await getWorksArchive(getCmsClient(Astro.locals), { tag, page: 1 }) : null;
if (!data) return Astro.rewrite("/404");
---

<WorksArchive data={data} />

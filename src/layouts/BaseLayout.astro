---
/**
 * 全ページ共通の <html> 枠。
 * SEO の値はページ側で解決して渡す（CMS docs/04 §18: ページの上書き → site_info の既定値）。
 */
import "../styles/global.css";
import fontUrl from "../assets/fonts/MadouFutoMaruGothic.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** 絶対URL。未指定なら出さない。 */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex: noindexProp = false } = Astro.props;
// GitHub Pages のプレビューは検索に載せない
const noindex = noindexProp || __PREVIEW_BUILD__;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

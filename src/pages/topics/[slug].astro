---
/**
 * TOPICS 詳細（Figma: topics-2）。見出しの帯は出さず、記事名を h1 にしたパネルだけを置く。
 * 本文の h2 は吹き出しのハート付き、h3 は左に線。本文中の画像は右に寄せて、続く文章を左に流す（PC）。
 * 位置・大きさはデザインの値（幅 1280 基準。design/csv/topics-2.csv）。
 * 外部リンクだけの記事・非公開の記事は 404。
 */
import type { GetStaticPaths } from "astro";
import PageLayout from "../../layouts/PageLayout.astro";
import CmsImage from "../../components/ui/CmsImage.astro";
import RichText from "../../components/ui/RichText.astro";
import Decor from "../../components/ui/Decor.astro";
import { getCmsClient } from "../../lib/cms/env";
import { getAllTopics, getTopicDetail } from "../../lib/cms/queries";
import { isEmptyRichText } from "../../lib/cms/richtext";
import { pageDescription, pageOgImage, pageTitle } from "../../lib/seo";
import { TOPIC_CATEGORY_LABEL, formatTopicDate, topicsListHref } from "../../lib/topics";
import planetRinged from "../../assets/decor/planet-ringed.webp";
import rocket from "../../assets/decor/rocket.webp";

// GitHub Pages のプレビュー（静的書き出し）で使う。本番（SSR）ではリクエストごとに解決する
export const getStaticPaths = (async () => {
  const topics = await getAllTopics(getCmsClient());
  return topics.filter((t) => t.slug && !t.externalLink).map((t) => ({ params: { slug: t.slug! } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const data = slug ? await getTopicDetail(getCmsClient(Astro.locals), slug) : null;
if (!data) return Astro.rewrite("/404");

const { siteInfo, topic } = data;
const label = TOPIC_CATEGORY_LABEL[topic.category];
---

<PageLayout
  siteInfo={siteInfo}
  title={pageTitle(siteInfo, topic.title)}
  description={pageDescription(siteInfo, topic.excerpt?.replace(/\s+/g, " "))}
  ogImage={pageOgImage(Astro.site, siteInfo, topic.thumbnail)}
  heading="Topics"
  hero="none"
  crumbs={[
    { label: "TOPICS", href: topicsListHref(null) },
    { label, href: topicsListHref(topic.category) },
    { label: topic.title },
  ]}
>
  <div class="stage article__stage">
    <article class:list={["article", `is-${topic.category}`]} aria-labelledby="article-title">
      <header class:list={["article__header", topic.thumbnail && "has-thumb"]}>
        <div class="article__heading">
          <p class="article__meta">
            <a class="article__category" href={topicsListHref(topic.category)}>{label}</a>
            <time datetime={topic.publishedDate}>{formatTopicDate(topic.publishedDate)}</time>
          </p>
          <h1 class="article__title" id="article-title">{topic.title}</h1>
        </div>
        {
          topic.thumbnail && (
            <figure class="article__thumb">
              <CmsImage media={topic.thumbnail} photo loading="eager" />
            </figure>
          )
        }
      </header>

      {!isEmptyRichText(topic.body) ? <RichText blocks={topic.body} class="article__body" /> : topic.excerpt && <p class="article__body">{topic.excerpt}</p>}
    </article>

    <Decor src={planetRinged} pc={[1160, 200, 84]} sp={false} front float delay={0.8} />
    <Decor src={rocket} pc={[-10, 590, 130]} sp={false} front float delay={1.6} />
  </div>
</PageLayout>

<style>
  /*
   * パネル: x=90・幅 1100、上端 y=226（帯 999×8 は y=217.5）。中の余白は左 76・右 74。
   * 見出し: 分類 y=398・記事名 y=446（3 行）・写真 466×352 が x=650・y=317。本文は y=764 から。
   */
  .article__stage {
    padding: calc(160 / 12.8 * 1cqw) var(--gutter) clamp(120px, calc(240 / 12.8 * 1vw), 240px);
  }

  .article {
    --accent: #00c0e8;
    position: relative;
    z-index: var(--z-content);
    max-width: 1100px;
    margin-inline: auto;
    padding: calc(91 / 12.8 * 1cqw) calc(74 / 12.8 * 1cqw) calc(215 / 12.8 * 1cqw) calc(76 / 12.8 * 1cqw);
    color: #1b1c22;
    background: #f6fdff;
    border-block: 6px solid var(--accent);
  }

  /* 上下の中央に太い帯（999 / 1100） */
  .article::before,
  .article::after {
    content: "";
    position: absolute;
    left: 50%;
    width: calc(999 / 1100 * 100%);
    height: 8px;
    background: var(--accent);
    translate: -50% 0;
  }

  .article::before {
    top: -8.5px;
  }

  .article::after {
    bottom: -8.5px;
  }

  .article__header {
    display: grid;
    align-items: center;
    gap: calc(50 / 12.8 * 1cqw);
  }

  .article__header.has-thumb {
    grid-template-columns: minmax(0, 434fr) minmax(0, 466fr);
  }

  .article__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .article__category {
    font-family: var(--font-label);
    font-size: clamp(16px, calc(20 / 12.8 * 1vw), 20px);
    line-height: 1;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--accent);
  }

  .article__category:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article__meta time {
    font-family: var(--font-pixel);
    font-size: 15px;
    letter-spacing: 0.08em;
    color: #3ad4ff;
  }

  .article__title {
    margin-top: clamp(20px, calc(40 / 12.8 * 1vw), 40px);
    font-size: clamp(24px, calc(34 / 12.8 * 1vw), 34px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .article__thumb {
    overflow: hidden;
    border-radius: 7px;
  }

  .article__thumb :global(img) {
    width: 100%;
    aspect-ratio: 466 / 352;
    object-fit: cover;
    object-position: center 30%;
  }

  /* ---- 本文 ---- */
  .article :global(.article__body) {
    display: flow-root;
    margin-top: calc(95 / 12.8 * 1cqw);
    font-size: 15px;
    line-height: 1.93;
    letter-spacing: 0.02em;
  }

  .article :global(.article__body > * + *) {
    margin-top: 1.93em;
  }

  /* h2: 吹き出しのハート（50×47）と大きめの見出し。本文まで 66 */
  .article :global(.article__body > h2) {
    display: flex;
    align-items: center;
    gap: 26px;
    min-height: 47px;
    padding: 0;
    font-size: clamp(24px, calc(34 / 12.8 * 1vw), 34px);
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: inherit;
    background: none;
    border: 0;
    clear: both;
  }

  .article :global(.article__body > h2::before) {
    content: "";
    flex: none;
    width: 50px;
    height: 47px;
    background: url("../../assets/icons/heart-bubble.webp") center / contain no-repeat;
  }

  .article :global(.article__body > h2:first-child) {
    margin-top: 0;
  }

  .article :global(.article__body > h2 + *),
  .article :global(.article__body > h3 + *) {
    margin-top: 60px;
  }

  /* h3: 左に 8×44 の線。前の本文から 110 */
  .article :global(.article__body > h3) {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 110px;
    padding: 0 0 0 22px;
    font-size: clamp(20px, calc(24 / 12.8 * 1vw), 24px);
    line-height: 1.4;
    border: 0;
    border-left: 8px solid #00addc;
    clear: both;
  }

  /* 本文中の画像（449×339・角丸 10）は右に寄せ、続く文章を左に流す */
  .article :global(.article__body > figure) {
    float: right;
    width: calc(449 / 952 * 100%);
    margin: 0 0 24px calc(57 / 952 * 100%);
    overflow: hidden;
    border-radius: 10px;
  }

  .article :global(.article__body > h3 + figure),
  .article :global(.article__body > h2 + figure) {
    margin-top: 54px;
  }

  .article :global(.article__body > figure + p) {
    margin-top: 60px;
  }

  .article :global(.article__body > figure img) {
    width: 100%;
    aspect-ratio: 449 / 339;
    object-fit: cover;
  }

  .article :global(.article__body a) {
    color: #00addc;
  }

  @media (max-width: 767px) {
    .article__stage {
      padding-top: 40px;
    }

    .article {
      padding: 40px 20px 64px;
    }

    .article__header.has-thumb {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .article :global(.article__body) {
      margin-top: 48px;
    }

    .article :global(.article__body > h2) {
      gap: 14px;
    }

    .article :global(.article__body > h2::before) {
      width: 38px;
      height: 36px;
    }

    .article :global(.article__body > h3) {
      margin-top: 64px;
    }

    .article :global(.article__body > h2 + *),
    .article :global(.article__body > h3 + *) {
      margin-top: 32px;
    }

    .article :global(.article__body > figure) {
      float: none;
      width: 100%;
      margin: 32px 0 0;
    }

    .article :global(.article__body > figure + p) {
      margin-top: 32px;
    }
  }
</style>

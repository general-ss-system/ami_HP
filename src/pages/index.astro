---
/**
 * トップページ。データはページでまとめて取得し、各セクションへ props で渡す（CMS docs/04 §11）。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Hero from "../components/sections/Hero.astro";
import Marquee from "../components/sections/Marquee.astro";
import Statement from "../components/sections/Statement.astro";
import Business from "../components/sections/Business.astro";
import Topics from "../components/sections/Topics.astro";
import Members from "../components/sections/Members.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import ShootingStars from "../components/ui/ShootingStars.astro";
import { CONTACT_HREF, SITE_NAME } from "../config/site";
import { getCmsClient } from "../lib/cms/env";
import { getTopPageData, reportCmsError } from "../lib/cms/queries";
import { pageDescription, pageOgImage } from "../lib/seo";
import { withBase } from "../lib/url";

const { siteInfo, home, services, topics, members } = await getTopPageData(getCmsClient(Astro.locals));

// SEO は site_info（CMS）の既定値。<title> は空にできないため、取得できなければサイト名にして記録する
const title = siteInfo?.defaultTitle ?? siteInfo?.companyName ?? SITE_NAME;
if (!siteInfo) reportCmsError("site_info is unavailable; using SITE_NAME for the top page title", {});
---

<BaseLayout title={title} description={pageDescription(siteInfo)} ogImage={pageOgImage(Astro.site, siteInfo)}>
  <SiteHeader />
  <div class="page">
    <ShootingStars />
    <main>
      {home && <Hero images={home.heroImages} />}
      <Marquee text={'Where "Tokimeki" Originates.'} />
      {home && <Statement statement={home.statement} />}
      <Business services={services} />
      <Topics topics={topics} moreHref={withBase("/topics")} />
      <Members members={members} moreHref={withBase("/member")} />
      <ContactCta body={home?.contactBody ?? null} href={withBase(CONTACT_HREF)} />
    </main>
    <SiteFooter siteInfo={siteInfo} />
  </div>
</BaseLayout>

<style>
  .page {
    isolation: isolate;
    overflow-x: clip;
    background:
      var(--bg-stars),
      var(--gradient-page);
  }
</style>

---
/**
 * SERVICE。事業（ami_services）を 1 つずつ、画像と本文で紹介する。
 * トップの「View more」からは #slug で各事業へ飛んでくる。
 */
import PageLayout from "../layouts/PageLayout.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import Decor from "../components/ui/Decor.astro";
import RichText from "../components/ui/RichText.astro";
import ServiceVisual from "../components/ui/ServiceVisual.astro";
import { CONTACT_HREF } from "../config/site";
import { getCmsClient } from "../lib/cms/env";
import { getServicePageData } from "../lib/cms/queries";
import { isEmptyRichText } from "../lib/cms/richtext";
import { pageDescription, pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";
import planetRinged from "../assets/decor/planet-ringed.webp";
import planetBunnyBlue from "../assets/decor/planet-bunny-blue.webp";
import sparkleViolet from "../assets/decor/sparkle-violet.webp";
import rocketCat from "../assets/decor/rocket-cat.webp";

const { siteInfo, services } = await getServicePageData(getCmsClient());

// 左右を交互に入れ替える飾り
const DECOR = [
  { src: planetRinged, pc: [1090, 40, 150] as const },
  { src: planetBunnyBlue, pc: [40, 60, 150] as const },
  { src: rocketCat, pc: [1070, 60, 180] as const },
];
---

<PageLayout
  title={pageTitle(siteInfo, "Service")}
  description={pageDescription(siteInfo, services.map((s) => s.title).join("・") || null)}
  heading="Service"
  headingSub="事業内容"
  crumbs={[{ label: "SERVICE" }]}
>
  {
    services.length > 0 && (
      <nav class="service-index" aria-label="事業の一覧">
        <ul>
          {services.map((service) => (
            <li>
              <a href={`#${service.slug ?? service.id}`}>{service.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    services.map((service, i) => (
      <section class:list={["service", i % 2 === 1 && "is-reverse"]} id={service.slug ?? service.id} aria-labelledby={`service-${service.id}`}>
        <div class="stage service__stage">
          <div class="service__visual">
            <ServiceVisual image={service.image} />
          </div>
          <div class="service__text">
            <p class="service__number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h2 class="service__title" id={`service-${service.id}`}>
              {service.title}
            </h2>
            {service.summary && <p class="service__summary">{service.summary}</p>}
            {!isEmptyRichText(service.body) && <RichText blocks={service.body} tone="dark" class="service__body" />}
          </div>
          <Decor src={DECOR[i % DECOR.length]!.src} pc={DECOR[i % DECOR.length]!.pc} sp={false} float delay={0.5 + i} />
          <Decor src={sparkleViolet} pc={[i % 2 ? 1150 : 90, 520, 50]} sp={false} twinkle delay={1.3 + i} />
        </div>
      </section>
    ))
  }

  <ContactCta body={null} href={withBase(CONTACT_HREF)} />
</PageLayout>

<style>
  .service-index ul {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    padding: 0 var(--gutter);
  }

  .service-index a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    font-size: 15px;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: 2px solid #000;
    transition:
      color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .service-index a::after {
    content: "↓";
    font-family: var(--font-pixel);
  }

  .service-index a:hover {
    color: #fff;
    background: var(--color-bg-3);
  }

  .service__stage {
    display: grid;
    grid-template-columns: minmax(0, 354px) minmax(0, 560px);
    justify-content: center;
    align-items: center;
    gap: clamp(40px, 8.6vw, 110px);
    padding: clamp(72px, 9.4vw, 120px) var(--gutter);
  }

  .is-reverse .service__visual {
    order: 2;
  }

  .service__visual,
  .service__text {
    position: relative;
    z-index: var(--z-content);
  }

  .service__number {
    font-family: var(--font-pixel);
    font-size: clamp(48px, 5.47vw, 70px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-accent-bright);
  }

  .service__title {
    margin-top: 12px;
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-accent-bright);
    letter-spacing: 0.04em;
    text-shadow: 1px 2px 0 rgb(4 16 74 / 0.4);
  }

  .service__summary {
    margin-top: 24px;
    font-size: clamp(15px, 1.33vw, 17px);
    line-height: 2;
  }

  .service__text :global(.service__body) {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 2px dashed rgb(255 255 255 / 0.3);
  }

  @media (max-width: 767px) {
    .service__stage {
      grid-template-columns: 1fr;
    }

    .service__visual {
      width: min(100%, 300px);
      margin-inline: auto;
    }

    .is-reverse .service__visual {
      order: 0;
    }
  }
</style>

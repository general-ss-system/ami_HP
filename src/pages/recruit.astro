---
/**
 * RECRUIT。採用メッセージ・職場写真（recruit）と、募集中の職種（job_positions）。
 * 各職種は #slug で開ける。応募はお問い合わせフォームから受け付ける。
 */
import PageLayout from "../layouts/PageLayout.astro";
import { isPageVisible } from "../lib/cms/queries";
import { respondHiddenPage } from "../lib/hidden-page";
import CmsImage from "../components/ui/CmsImage.astro";
import Decor from "../components/ui/Decor.astro";
import PageHeading from "../components/ui/PageHeading.astro";
import Panel from "../components/ui/Panel.astro";
import RichText from "../components/ui/RichText.astro";
import { CONTACT_HREF } from "../config/site";
import { getCmsClient } from "../lib/cms/env";
import { getRecruitPageData } from "../lib/cms/queries";
import { isEmptyRichText } from "../lib/cms/richtext";
import { EMPLOYMENT_TYPE_LABEL } from "../lib/recruit";
import { pageDescription, pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";
import rocketBunny from "../assets/decor/rocket-bunny.webp";
import sparkleGold from "../assets/decor/sparkle-gold.webp";
import moonBunny from "../assets/decor/moon-bunny.webp";
import sparkleBlue from "../assets/decor/sparkle-blue.webp";

const { siteInfo, recruit, positions } = await getRecruitPageData(getCmsClient(Astro.locals));
// 管理画面のページの表示設定で非表示なら出さない（下書きのプレビューでは確認できる）
if (!isPageVisible(siteInfo, "recruit") && !Astro.locals.previewToken) return respondHiddenPage((p) => Astro.rewrite(p));
---

<PageLayout
  siteInfo={siteInfo}
  title={pageTitle(siteInfo, "Recruit")}
  description={pageDescription(siteInfo, recruit?.messageTitle)}
  heading="Recruit"
  headingSub="採用情報"
  crumbs={[{ label: "RECRUIT" }]}
>
  {
    recruit && (
      <section class="recruit-message" aria-labelledby="recruit-message-title">
        <div class="stage recruit-message__stage">
          <div class:list={["recruit-message__body", recruit.mainImage && "has-image"]}>
            {recruit.mainImage && (
              <figure class="recruit-message__photo">
                <CmsImage media={recruit.mainImage} photo />
              </figure>
            )}
            <div>
              <h2 class="recruit-message__title" id="recruit-message-title">
                {recruit.messageTitle}
              </h2>
              {!isEmptyRichText(recruit.messageBody) && <RichText blocks={recruit.messageBody} tone="dark" />}
            </div>
          </div>

          {recruit.gallery.length > 0 && (
            <ul class="recruit-gallery" aria-label="職場のようす">
              {recruit.gallery.map((media, i) => (
                <li style={{ "--tilt": `${i % 2 ? 2 : -2}deg` }}>
                  <CmsImage media={media} photo />
                </li>
              ))}
            </ul>
          )}

          <Decor src={rocketBunny} pc={[1090, 0, 160]} sp={false} float delay={0.6} />
          <Decor src={sparkleGold} pc={[40, 380, 56]} sp={[330, 40, 28]} twinkle delay={1.1} />
        </div>
      </section>
    )
  }

  <section class="jobs" aria-labelledby="jobs-title">
    <div class="stage jobs__stage">
      <PageHeading text="Jobs" sub="募集職種" level={2} tilt={2} id="jobs-title" />

      {
        positions.length > 0 ? (
          <>
            <ul class="jobs__list">
              {positions.map((position) => (
                <li id={position.slug ?? position.id}>
                  <Panel as="article" class="job" aria-labelledby={`job-${position.id}`}>
                    <p class="job__meta">
                      <span class="job__type">{EMPLOYMENT_TYPE_LABEL[position.employmentType]}</span>
                      {position.location && <span class="job__location">勤務地: {position.location}</span>}
                    </p>
                    <h3 class="job__title" id={`job-${position.id}`}>
                      {position.title}
                    </h3>
                    {position.summary && <p class="job__summary">{position.summary}</p>}
                    {!isEmptyRichText(position.description) && <RichText blocks={position.description} class="job__description" />}
                  </Panel>
                </li>
              ))}
            </ul>
            <div class="jobs__apply">
              <p>ご応募・ご質問は、お問い合わせフォームから職種名を添えてお送りください。</p>
              <a class="jobs__apply-button" href={withBase(CONTACT_HREF)}>
                応募する<span aria-hidden="true"> ➡</span>
              </a>
            </div>
          </>
        ) : (
          <p class="jobs__empty">現在、募集している職種はありません。</p>
        )
      }

      <Decor src={moonBunny} pc={[30, 60, 120]} sp={false} float delay={1.5} />
      <Decor src={sparkleBlue} pc={[1160, 200, 64]} sp={false} twinkle delay={0.8} />
    </div>
  </section>
</PageLayout>

<style>
  .recruit-message__stage {
    padding: 0 var(--gutter) clamp(64px, 7.8vw, 100px);
  }

  .recruit-message__body {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    max-width: 1000px;
    margin-inline: auto;
  }

  .recruit-message__body.has-image {
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    align-items: center;
  }

  .recruit-message__photo {
    overflow: hidden;
    border: 3px solid #fff;
    border-radius: 16px;
    box-shadow: 0 16px 40px rgb(4 16 74 / 0.45);
    rotate: 2.5deg;
  }

  .recruit-message__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .recruit-message__title {
    margin-bottom: 28px;
    font-size: clamp(20px, 2.03vw, 26px);
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.08em;
    color: var(--color-accent-bright);
    text-shadow: 1px 2px 0 rgb(4 16 74 / 0.4);
  }

  .recruit-gallery {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(16px, 2.5vw, 32px);
    max-width: 1000px;
    margin: clamp(48px, 6.25vw, 80px) auto 0;
  }

  .recruit-gallery li {
    overflow: hidden;
    border: 3px solid #fff;
    border-radius: 12px;
    box-shadow: 0 10px 28px rgb(4 16 74 / 0.4);
    rotate: var(--tilt);
  }

  .recruit-gallery :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .jobs__stage {
    padding: clamp(40px, 5vw, 64px) var(--gutter) clamp(96px, 12.5vw, 160px);
  }

  .jobs__list {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    gap: clamp(24px, 3.125vw, 40px);
    max-width: 880px;
    margin: clamp(48px, 6.25vw, 80px) auto 0;
  }

  .jobs__list > li {
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  .job__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-size: 13px;
  }

  .job__type {
    padding: 4px 12px;
    color: #fff;
    background: var(--color-border);
    font-family: var(--font-pixel);
    letter-spacing: 0.08em;
  }

  .job__title {
    margin-top: 16px;
    font-size: clamp(19px, 1.72vw, 22px);
    font-weight: 700;
    line-height: 1.6;
  }

  .job__summary {
    margin-top: 12px;
    line-height: 1.9;
  }

  .job :global(.job__description) {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 2px dashed rgb(27 28 34 / 0.2);
  }

  .jobs__apply {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    justify-items: center;
    gap: 24px;
    margin-top: clamp(48px, 6.25vw, 80px);
    line-height: 2;
    text-align: center;
    text-shadow: 1px 2px 0 rgb(4 16 74 / 0.4);
  }

  .jobs__apply-button {
    display: inline-block;
    padding: 16px 48px;
    color: var(--color-text);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    box-shadow: 6px 6px 0 rgb(4 16 74 / 0.45);
    font-family: var(--font-pixel);
    font-size: 18px;
    text-decoration: none;
    text-shadow: none;
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .jobs__apply-button:hover {
    translate: 3px 3px;
    box-shadow: 3px 3px 0 rgb(4 16 74 / 0.45);
  }

  .jobs__empty {
    position: relative;
    z-index: var(--z-content);
    margin-top: clamp(48px, 6.25vw, 80px);
    text-align: center;
  }

  @media (max-width: 767px) {
    .recruit-message__body.has-image {
      grid-template-columns: 1fr;
    }

    .recruit-message__photo {
      width: min(100%, 300px);
      margin-inline: auto;
    }

    .recruit-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jobs__apply-button {
      transition: none;
    }
  }
</style>
